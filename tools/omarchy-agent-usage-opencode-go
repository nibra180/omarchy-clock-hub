#!/usr/bin/env python3
# omarchy:summary=Print the OpenCode Go usage record as JSON
# omarchy:args=[--force] [--limits-only]
"""Collect OpenCode Go plan-quota and local usage into one display-ready
JSON record, written straight into
~/.local/state/omarchy/agents/usage/opencode-go.json.

Omarchy ships no collector for OpenCode Go: omarchy-agent-usage-claude and
omarchy-agent-usage-codex already read opencode's local session database for
messages that ran on the Anthropic or OpenAI provider, but never for the Go
plan itself (providerID "opencode-go"), so clock-hub covers that gap here,
following the same two sources those collectors use.

Plan quota (the rolling 5-hour, weekly, and monthly windows) comes from
https://opencode.ai/zen/go/v1/usage, the same endpoint the OpenCode console
and TUI plugins use; it reports only a used percentage per window, nothing
else. Today's prompts, sessions, and token totals instead come from a local,
read-only scan of opencode's own session database, filtered to messages that
used the "opencode-go" provider, exactly like the Claude and Codex collectors
already do for their own provider ids.
"""

from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import sqlite3
import sys
import tempfile
import time
import urllib.error
import urllib.request
from pathlib import Path
from typing import Any

AGENT_ID = "opencode-go"
AGENT_NAME = "OpenCode Go"
AUTH_HELP = "Run `opencode auth login -p opencode-go` or set OPENCODE_API_KEY."
USAGE_URL = "https://opencode.ai/zen/go/v1/usage"

# A scan this recent is only reused to dedup concurrent collector runs; every
# periodic widget refresh lands a real rescan. --limits-only promises only
# fresh limits, so it may reuse a scan for up to 15 minutes, matching the
# Codex collector's convention.
SCAN_REUSE_SECONDS = 20
LIMITS_ONLY_REUSE_SECONDS = 900


def cache_root() -> Path:
  root = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "omarchy" / "agent-usage"
  root.mkdir(parents=True, exist_ok=True)
  return root


def date_string(value: dt.date) -> str:
  return value.strftime("%Y-%m-%d")


def recent_date_strings() -> list[str]:
  today = dt.datetime.now().date()
  return [date_string(today - dt.timedelta(days=offset)) for offset in range(6, -1, -1)]


def local_date_string() -> str:
  return date_string(dt.datetime.now().date())


def number(value: Any) -> int:
  try:
    n = float(value or 0)
    return round(n) if n == n else 0
  except Exception:
    return 0


def empty_bucket() -> dict[str, int]:
  return {
    "inputTokens": 0,
    "outputTokens": 0,
    "cacheReadInputTokens": 0,
    "cacheCreationInputTokens": 0,
  }


def read_fresh_json(path: Path, max_age_seconds: float) -> dict[str, Any] | None:
  if max_age_seconds <= 0 or not path.exists():
    return None
  try:
    if time.time() - path.stat().st_mtime <= max_age_seconds:
      return json.loads(path.read_text(encoding="utf-8"))
  except Exception:
    return None
  return None


def write_json(path: Path, payload: dict[str, Any]) -> None:
  handle_fd, tmp_name = tempfile.mkstemp(dir=path.parent, prefix=path.name + ".", suffix=".tmp")
  tmp = Path(tmp_name)
  try:
    with os.fdopen(handle_fd, "w", encoding="utf-8") as handle:
      handle.write(json.dumps(payload, separators=(",", ":"), sort_keys=True) + "\n")
    tmp.chmod(0o644)
    tmp.replace(path)
  except BaseException:
    tmp.unlink(missing_ok=True)
    raise


def base_record(**overrides: Any) -> dict[str, Any]:
  record: dict[str, Any] = {
    "schemaVersion": 1,
    "id": AGENT_ID,
    "name": AGENT_NAME,
    "updatedAt": dt.datetime.now(dt.timezone.utc).isoformat(),
    "ready": False,
    "hasLocalStats": False,
    "scope": "device",
    "hasPromptStats": False,
    "tierLabel": "Go",
    "usageStatusText": "",
    "authHelpText": "",
    "limits": [],
    "todayPrompts": 0,
    "todaySessions": 0,
    "todayTotalTokens": 0,
    "todayTokensByModel": {},
    "recentDays": [],
    "totalPrompts": 0,
    "totalSessions": 0,
    "activeDays": 0,
    "activeDates": [],
    "modelUsage": {},
  }
  record.update(overrides)
  return record


# ------------------------------------------------------------- credentials


def opencode_auth_path() -> Path:
  data_home = Path(os.environ.get("XDG_DATA_HOME") or (Path.home() / ".local" / "share"))
  return data_home / "opencode" / "auth.json"


def read_opencode_key(path: Path, provider_id: str) -> str:
  try:
    parsed = json.loads(path.read_text())
  except (OSError, json.JSONDecodeError):
    return ""
  entry = parsed.get(provider_id) if isinstance(parsed, dict) else None
  if not isinstance(entry, dict):
    return ""
  return str(entry.get("key") or "").strip()


def resolve_api_key(auth_path: Path) -> str:
  env_key = str(os.environ.get("OPENCODE_API_KEY", "")).strip()
  if env_key:
    return env_key
  # The usage endpoint accepts any workspace key: a dedicated Go key first,
  # then the Zen key opencode already stores for the free tier.
  return read_opencode_key(auth_path, "opencode-go") or read_opencode_key(auth_path, "opencode")


# -------------------------------------------------------------- plan quota


def fetch_quota(api_key: str, usage_url: str) -> tuple[list[dict[str, Any]], str]:
  # Cloudflare's WAF rejects urllib's default "Python-urllib/x.y" User-Agent
  # outright (error 1010) before the request ever reaches opencode's API.
  headers = {"Authorization": f"Bearer {api_key}", "User-Agent": "clock-hub/1 (+https://github.com/nibra180/omarchy-clock-hub)"}
  request = urllib.request.Request(usage_url, headers=headers)
  try:
    with urllib.request.urlopen(request, timeout=15) as response:
      payload = json.load(response)
  except urllib.error.HTTPError as error:
    if error.code in (401, 403):
      return [], "OpenCode Go key rejected"
    return [], f"OpenCode Go API returned HTTP {error.code}"
  except (urllib.error.URLError, TimeoutError, json.JSONDecodeError, OSError):
    return [], "Could not reach opencode.ai"

  usage = payload.get("usage") if isinstance(payload, dict) else None
  if not isinstance(usage, dict):
    return [], ""

  # Percent is the server's own "used" fraction (0-100); label text mirrors
  # Claude's and Codex's records so Model.js's window-title mapping (which
  # goes by keyword, not by agent) renders the same titles here.
  windows = (("rolling", "Session (5-hour)"), ("weekly", "Weekly (7-day)"), ("monthly", "Monthly"))
  limits: list[dict[str, Any]] = []
  for key, label in windows:
    window = usage.get(key)
    if not isinstance(window, dict):
      continue
    percent = window.get("percent")
    if not isinstance(percent, (int, float)):
      continue
    limits.append({
      "label": label,
      "percent": percent / 100,
      "resetsAt": str(window.get("resetsAt") or ""),
    })
  return limits, ""


# ---------------------------------------------------------------- local scan


def opencode_db_path() -> Path:
  data_home = Path(os.environ.get("XDG_DATA_HOME") or (Path.home() / ".local" / "share"))
  return data_home / "opencode" / "opencode.db"


def scan_local_usage(db: Path, max_age_seconds: float) -> dict[str, Any] | None:
  if not db.is_file():
    return None

  cache_file = cache_root() / f"{AGENT_ID}-local.json"
  cached = read_fresh_json(cache_file, max_age_seconds)
  if cached is not None:
    return cached.get("stats")

  today = local_date_string()
  recent_dates = recent_date_strings()
  recent = {day: {"date": day, "messageCount": 0} for day in recent_dates}
  sessions: set[str] = set()
  active_days: set[str] = set()
  today_sessions: set[str] = set()
  today_tokens: dict[str, int] = {}
  usage_by_model: dict[str, dict[str, int]] = {}
  prompts = 0
  today_prompt_count = 0
  today_token_total = 0

  try:
    # Read-only: opencode may be writing right now.
    conn = sqlite3.connect(db.resolve().as_uri() + "?mode=ro", uri=True, timeout=2)
  except sqlite3.Error:
    return None
  try:
    conn.execute("PRAGMA query_only = ON")
    for session_id, raw in conn.execute("SELECT session_id, data FROM message"):
      try:
        entry = json.loads(raw)
        # Exact match: the Go plan's own provider id, not the underlying
        # model provider a Go session happens to route through.
        if not isinstance(entry, dict) or entry.get("role") != "assistant":
          continue
        if str(entry.get("providerID") or "") != AGENT_ID:
          continue
        tokens = entry.get("tokens") or {}
        cache = tokens.get("cache") or {}
        input_tokens = number(tokens.get("input"))
        # opencode keeps thinking tokens out of output; both are generated.
        output_tokens = number(tokens.get("output")) + number(tokens.get("reasoning"))
        cache_read = number(cache.get("read"))
        cache_write = number(cache.get("write"))
        total = input_tokens + output_tokens + cache_read + cache_write
        if total <= 0:
          continue

        created = number((entry.get("time") or {}).get("created"))
        day = dt.datetime.fromtimestamp(created / 1000).strftime("%Y-%m-%d") if created > 0 else today
        model = str(entry.get("modelID") or AGENT_ID).rstrip("/").split("/")[-1]
      except Exception:
        continue
      session_key = "opencode:" + str(session_id)
      sessions.add(session_key)
      active_days.add(day)
      prompts += 1

      bucket = usage_by_model.setdefault(model, empty_bucket())
      bucket["inputTokens"] += input_tokens
      bucket["outputTokens"] += output_tokens
      bucket["cacheReadInputTokens"] += cache_read
      bucket["cacheCreationInputTokens"] += cache_write

      if day in recent:
        recent[day]["messageCount"] += total
      if day == today:
        today_prompt_count += 1
        today_sessions.add(session_key)
        today_token_total += total
        today_tokens[model] = today_tokens.get(model, 0) + total
  except sqlite3.Error:
    return None
  finally:
    conn.close()

  stats: dict[str, Any] | None = None
  if prompts > 0:
    stats = {
      "todayPrompts": today_prompt_count,
      "todaySessions": len(today_sessions),
      "todayTotalTokens": today_token_total,
      "todayTokensByModel": today_tokens,
      "recentDays": [recent[day] for day in recent_dates],
      "modelUsage": usage_by_model,
      "totalPrompts": prompts,
      "totalSessions": len(sessions),
      "activeDays": len(active_days),
      "activeDates": sorted(active_days),
    }
  write_json(cache_file, {"stats": stats})
  return stats


# --------------------------------------------------------------------- main


def scan(scan_age: float, auth_path: Path, db: Path, usage_url: str) -> dict[str, Any]:
  api_key = resolve_api_key(auth_path)
  if not api_key:
    return base_record(usageStatusText="OpenCode Go unavailable", authHelpText=AUTH_HELP)

  limits, error = fetch_quota(api_key, usage_url)
  record = base_record(ready=True, limits=limits)
  if error:
    record["usageStatusText"] = error
    record["authHelpText"] = AUTH_HELP if "key" in error.lower() else ""

  stats = scan_local_usage(db, scan_age)
  if stats:
    record.update(stats)
    record["hasLocalStats"] = True
    record["hasPromptStats"] = True

  return record


def write_record(record: dict[str, Any]) -> None:
  usage_dir = Path(os.environ.get("XDG_STATE_HOME") or (Path.home() / ".local" / "state")) / "omarchy" / "agents" / "usage"
  usage_dir.mkdir(parents=True, exist_ok=True)
  write_json(usage_dir / f"{AGENT_ID}.json", record)


def main() -> int:
  parser = argparse.ArgumentParser(description="Print the OpenCode Go usage record as JSON")
  parser.add_argument("--force", action="store_true")
  parser.add_argument("--limits-only", action="store_true")
  parser.add_argument("--auth-path", default=os.environ.get("OPENCODE_AUTH_PATH", ""))
  parser.add_argument("--db-path", default=os.environ.get("OPENCODE_DB_PATH", ""))
  parser.add_argument("--usage-url", default=os.environ.get("OPENCODE_GO_USAGE_URL", USAGE_URL))
  args = parser.parse_args()

  if args.force:
    scan_age = 0.0
  elif args.limits_only:
    scan_age = LIMITS_ONLY_REUSE_SECONDS
  else:
    scan_age = SCAN_REUSE_SECONDS

  auth_path = Path(args.auth_path).expanduser() if args.auth_path else opencode_auth_path()
  db = Path(args.db_path).expanduser() if args.db_path else opencode_db_path()

  try:
    record = scan(scan_age, auth_path, db, args.usage_url)
  except Exception as error:
    record = base_record(usageStatusText="OpenCode Go unavailable", authHelpText="OpenCode Go usage scan failed")
    print(f"omarchy-agent-usage-opencode-go: {type(error).__name__}", file=sys.stderr)

  write_record(record)
  print(json.dumps(record, separators=(",", ":")))
  return 0


if __name__ == "__main__":
  raise SystemExit(main())
