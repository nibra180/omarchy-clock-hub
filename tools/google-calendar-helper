APP_ID = "io.github.nibra180.clock-hub"
CLIENT_FILENAME = "google-oauth-client.json"
SCOPE = "https://www.googleapis.com/auth/calendar.events.readonly"
AUTH_TIMEOUT_SECONDS = 120
AUTH_CALLBACK_PATH = "/oauth2callback"
GOOGLE_AUTH_URL = "https://accounts.google.com/o/oauth2/auth"
GOOGLE_TOKEN_URL = "https://oauth2.googleapis.com/token"
CALENDAR_EVENTS_URL = "https://www.googleapis.com/calendar/v3/calendars/primary/events"
REVOKE_URL = "https://oauth2.googleapis.com/revoke"
SECRET_ATTRIBUTES = ("application", APP_ID, "account", "google-calendar")
SECRET_LABEL = "Clock Hub Google Calendar"
HTTP_TIMEOUT_SECONDS = 30
SECRET_TOOL_TIMEOUT_SECONDS = 10
MAX_RESPONSE_BYTES = 5 * 1024 * 1024
MAX_EVENT_PAGES = 100
MAX_EVENTS = 5000
MAX_SUMMARY_LENGTH = 500
MAX_QUERY_SPAN = timedelta(days=60)

UrlOpen = Callable[..., Any]


class HelperError(Exception):
    code = "helper_error"
    exit_code = 1

    def __init__(self, message: str) -> None:
        super().__init__(message)
        self.message = message


class UsageError(HelperError):
    code = "usage_error"
    exit_code = 2


class ClientConfigError(HelperError):
    code = "invalid_client_config"


class MissingDependencyError(HelperError):
    code = "missing_dependency"


class KeyringError(HelperError):
    code = "keyring_error"


class AuthenticationError(HelperError):
    code = "authentication_error"


class AuthenticationRequiredError(HelperError):
    code = "authentication_required"


class NetworkError(HelperError):
    code = "network_error"


class ApiError(HelperError):
    code = "api_error"


@dataclass(frozen=True)
class OAuthClient:
    client_id: str
    client_secret: Optional[str] = field(default=None, repr=False)
    auth_uri: str = GOOGLE_AUTH_URL
    token_uri: str = GOOGLE_TOKEN_URL


class JsonArgumentParser(argparse.ArgumentParser):
    def error(self, message: str) -> None:
        raise UsageError(message)


class SecretStore:
    """Linux Secret Service access through secret-tool."""

    def __init__(
        self,
        executable: Optional[str] = None,
        runner: Callable[..., subprocess.CompletedProcess[bytes]] = subprocess.run,
    ) -> None:
        self.executable = executable or shutil.which("secret-tool")
        self.runner = runner

    @property
    def available(self) -> bool:
        return bool(self.executable)

    def _require_executable(self) -> str:
        if not self.executable:
            raise MissingDependencyError("secret-tool is required")
        return self.executable

    def lookup(self) -> Optional[str]:
        command = [self._require_executable(), "lookup", *SECRET_ATTRIBUTES]
        try:
            result = self.runner(
                command,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                check=False,
                timeout=SECRET_TOOL_TIMEOUT_SECONDS,
            )
        except (OSError, subprocess.TimeoutExpired) as error:
            raise KeyringError("could not access the secret store") from error
        if result.returncode == 1:
            return None
        if result.returncode != 0:
            raise KeyringError("could not access the secret store")
        try:
            token = result.stdout.decode("utf-8").rstrip("\r\n")
        except UnicodeDecodeError as error:
            raise KeyringError("secret store returned invalid data") from error
        if len(token) > 4096:
            raise KeyringError("secret store returned an invalid token")
        return token or None

    def store(self, refresh_token: str) -> None:
        command = [
            self._require_executable(),
            "store",
            f"--label={SECRET_LABEL}",
            *SECRET_ATTRIBUTES,
        ]
        try:
            result = self.runner(
                command,
                input=refresh_token.encode("utf-8"),
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                check=False,
                timeout=SECRET_TOOL_TIMEOUT_SECONDS,
            )
        except (OSError, subprocess.TimeoutExpired) as error:
            raise KeyringError("could not write to the secret store") from error
        if result.returncode != 0:
            raise KeyringError("could not write to the secret store")

    def delete(self) -> None:
        command = [self._require_executable(), "clear", *SECRET_ATTRIBUTES]
        try:
            result = self.runner(
                command,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                check=False,
                timeout=SECRET_TOOL_TIMEOUT_SECONDS,
            )
        except (OSError, subprocess.TimeoutExpired) as error:
            raise KeyringError("could not clear the secret store") from error
        if result.returncode not in (0, 1):
            raise KeyringError("could not clear the secret store")


def client_config_path() -> Path:
    config_home = os.environ.get("XDG_CONFIG_HOME")
    base = Path(config_home).expanduser() if config_home else Path.home() / ".config"
    return base / APP_ID / CLIENT_FILENAME


def parse_client_config(path: Optional[Path] = None) -> OAuthClient:
    config_path = path or client_config_path()
    try:
        raw = config_path.read_text(encoding="utf-8")
    except FileNotFoundError as error:
        raise ClientConfigError("Google OAuth client file is missing") from error
    except OSError as error:
        raise ClientConfigError("Google OAuth client file could not be read") from error

    try:
        document = json.loads(raw)
    except (json.JSONDecodeError, UnicodeDecodeError) as error:
        raise ClientConfigError("Google OAuth client file is not valid JSON") from error

    installed = document.get("installed") if isinstance(document, dict) else None
    if not isinstance(installed, dict):
        raise ClientConfigError("Google OAuth client file must contain an installed client")

    client_id = installed.get("client_id")
    client_secret = installed.get("client_secret")
    auth_uri = installed.get("auth_uri", OAuthClient.auth_uri)
    token_uri = installed.get("token_uri", OAuthClient.token_uri)
    if not isinstance(client_id, str) or not client_id.strip():
        raise ClientConfigError("Google OAuth client ID is missing")
    if client_secret is not None and not isinstance(client_secret, str):
        raise ClientConfigError("Google OAuth client secret is invalid")
    if auth_uri != GOOGLE_AUTH_URL or token_uri != GOOGLE_TOKEN_URL:
        raise ClientConfigError("Google OAuth client contains unexpected endpoints")

    return OAuthClient(
        client_id=client_id,
        client_secret=client_secret or None,
        auth_uri=auth_uri,
        token_uri=token_uri,
    )


def _is_https_url(value: Any) -> bool:
    if not isinstance(value, str):
        return False
    parsed = urllib.parse.urlparse(value)
    return parsed.scheme == "https" and bool(parsed.netloc)


def generate_pkce(random_bytes: Callable[[int], bytes] = secrets.token_bytes) -> tuple[str, str]:
    verifier = _base64url(random_bytes(64))
    challenge = _base64url(hashlib.sha256(verifier.encode("ascii")).digest())
    return verifier, challenge


def _base64url(value: bytes) -> str:
    return base64.urlsafe_b64encode(value).decode("ascii").rstrip("=")


def build_authorization_url(
    client: OAuthClient,
    redirect_uri: str,
    state: str,
    code_challenge: str,
) -> str:
    query = urllib.parse.urlencode(
        {
            "access_type": "offline",
            "client_id": client.client_id,
            "code_challenge": code_challenge,
            "code_challenge_method": "S256",
            "prompt": "consent",
            "redirect_uri": redirect_uri,
            "response_type": "code",
            "scope": SCOPE,
            "state": state,
        }
    )
    return f"{client.auth_uri}?{query}"


def open_default_browser(url: str) -> bool:
    xdg_open = shutil.which("xdg-open")
    if xdg_open:
        try:
            subprocess.Popen(
                [xdg_open, url],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
            )
            return True
        except OSError:
            pass
    return bool(webbrowser.open(url, new=1))


def _callback_handler(expected_state: str, result: dict[str, str]) -> type[BaseHTTPRequestHandler]:
    class OAuthCallbackHandler(BaseHTTPRequestHandler):
        def do_GET(self) -> None:
            if self.client_address[0] != "127.0.0.1":
                self.send_error(403)
                return
            parsed = urllib.parse.urlparse(self.path)
            if parsed.path != AUTH_CALLBACK_PATH:
                self.send_error(404)
                return
            values = urllib.parse.parse_qs(parsed.query)
            state = _first(values, "state")
            if not state or not secrets.compare_digest(state, expected_state):
                # Reject unrelated localhost probes without ending the real flow.
                self._reply(400, "Authorization failed. You can close this window.")
                return
            error = _first(values, "error")
            code = _first(values, "code")
            if error:
                result["error"] = error
                self._reply(400, "Authorization was not completed. You can close this window.")
                return
            if not code:
                result["error"] = "missing_code"
                self._reply(400, "Authorization failed. You can close this window.")
                return
            result["code"] = code
            self._reply(200, "Calendar connected. You can close this window.")

        def _reply(self, status: int, message: str) -> None:
            body = message.encode("utf-8")
            self.send_response(status)
            self.send_header("Content-Type", "text/plain; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(body)

        def log_message(self, format: str, *args: Any) -> None:
            return

    return OAuthCallbackHandler


def _first(values: Mapping[str, list[str]], key: str) -> Optional[str]:
    entries = values.get(key)
    return entries[0] if entries else None


def wait_for_callback(
    server: HTTPServer,
    result: Mapping[str, str],
    timeout: float = AUTH_TIMEOUT_SECONDS,
    monotonic: Callable[[], float] = time.monotonic,
) -> Mapping[str, str]:
    deadline = monotonic() + timeout
    while not result:
        remaining = deadline - monotonic()
        if remaining <= 0:
            raise AuthenticationError("authorization timed out")
        server.timeout = min(remaining, 1.0)
        server.handle_request()
    return result


def authorize(
    client: OAuthClient,
    secret_store: SecretStore,
    *,
    urlopen: UrlOpen = urllib.request.urlopen,
    browser_opener: Callable[[str], bool] = open_default_browser,
    server_factory: Callable[..., HTTPServer] = HTTPServer,
) -> dict[str, Any]:
    if not secret_store.available:
        raise MissingDependencyError("secret-tool is required")

    verifier, challenge = generate_pkce()
    state = secrets.token_urlsafe(32)
    callback_result: dict[str, str] = {}
    handler = _callback_handler(state, callback_result)
    try:
        server = server_factory(("127.0.0.1", 0), handler)
    except OSError as error:
        raise AuthenticationError("could not start the local authorization callback") from error

    try:
        port = server.server_address[1]
        redirect_uri = f"http://127.0.0.1:{port}{AUTH_CALLBACK_PATH}"
        authorization_url = build_authorization_url(client, redirect_uri, state, challenge)
        if not browser_opener(authorization_url):
            raise AuthenticationError("could not open the default browser")
        wait_for_callback(server, callback_result)
    finally:
        server.server_close()

    if "code" not in callback_result:
        if callback_result.get("error") == "access_denied":
            raise AuthenticationError("authorization was denied")
        if callback_result.get("error") == "invalid_state":
            raise AuthenticationError("authorization state did not match")
        raise AuthenticationError("authorization did not return a code")

    token = request_json(
        client.token_uri,
        form={
            "client_id": client.client_id,
            "code": callback_result["code"],
            "code_verifier": verifier,
            "grant_type": "authorization_code",
            "redirect_uri": redirect_uri,
            **({"client_secret": client.client_secret} if client.client_secret else {}),
        },
        urlopen=urlopen,
        context="token",
    )
    refresh_token = token.get("refresh_token")
    if not isinstance(refresh_token, str) or not refresh_token:
        raise AuthenticationError("Google did not return a refresh token")
    secret_store.store(refresh_token)
    return {"ok": True, "connected": True}


def request_json(
    url: str,
    *,
    form: Optional[Mapping[str, str]] = None,
    headers: Optional[Mapping[str, str]] = None,
    urlopen: UrlOpen = urllib.request.urlopen,
    context: str = "api",
) -> dict[str, Any]:
    body = None
    request_headers = {"Accept": "application/json"}
    if headers:
        request_headers.update(headers)
    if form is not None:
        body = urllib.parse.urlencode(form).encode("utf-8")
        request_headers["Content-Type"] = "application/x-www-form-urlencoded"
    request = urllib.request.Request(url, data=body, headers=request_headers)
    try:
        with urlopen(request, timeout=HTTP_TIMEOUT_SECONDS) as response:
            raw = response.read(MAX_RESPONSE_BYTES + 1)
            if len(raw) > MAX_RESPONSE_BYTES:
                raise ApiError("Google response exceeded the size limit")
    except urllib.error.HTTPError as error:
        try:
            error_code = _read_google_error_code(error)
        finally:
            error.close()
        if context == "refresh" and error_code == "invalid_grant":
            raise AuthenticationRequiredError("Google authorization has expired") from error
        if error.code == 401:
            raise AuthenticationRequiredError("Google authorization is no longer valid") from error
        if context in ("token", "refresh"):
            raise AuthenticationError("Google rejected the authorization request") from error
        raise ApiError("Google Calendar rejected the request") from error
    except (urllib.error.URLError, TimeoutError, OSError) as error:
        raise NetworkError("could not reach Google Calendar") from error

    if not raw:
        return {}
    try:
        value = json.loads(raw.decode("utf-8"))
    except (json.JSONDecodeError, UnicodeDecodeError) as error:
        raise ApiError("Google returned an invalid response") from error
    if not isinstance(value, dict):
        raise ApiError("Google returned an invalid response")
    return value


def _read_google_error_code(error: urllib.error.HTTPError) -> Optional[str]:
    try:
        raw = error.read(MAX_RESPONSE_BYTES + 1)
        if len(raw) > MAX_RESPONSE_BYTES:
            return None
        value = json.loads(raw.decode("utf-8"))
    except (OSError, ValueError, UnicodeDecodeError):
        return None
    if not isinstance(value, dict):
        return None
    detail = value.get("error")
    if isinstance(detail, str):
        return detail
    if isinstance(detail, dict) and isinstance(detail.get("status"), str):
        return detail["status"]
    return None


def refresh_access_token(
    client: OAuthClient,
    secret_store: SecretStore,
    *,
    urlopen: UrlOpen = urllib.request.urlopen,
) -> str:
    refresh_token = secret_store.lookup()
    if not refresh_token:
        raise AuthenticationRequiredError("Google Calendar is not connected")
    try:
        token = request_json(
            client.token_uri,
            form={
                "client_id": client.client_id,
                "grant_type": "refresh_token",
                "refresh_token": refresh_token,
                **({"client_secret": client.client_secret} if client.client_secret else {}),
            },
            urlopen=urlopen,
            context="refresh",
        )
    except AuthenticationRequiredError:
        secret_store.delete()
        raise
    access_token = token.get("access_token")
    if not isinstance(access_token, str) or not access_token:
        raise AuthenticationError("Google did not return an access token")
    return access_token


def fetch_events(
    access_token: str,
    time_min: str,
    time_max: str,
    *,
    urlopen: UrlOpen = urllib.request.urlopen,
) -> list[dict[str, Any]]:
    fields = (
        "nextPageToken,items(id,summary,status,start,end,eventType,"
        "transparency,attendees(self,responseStatus))"
    )
    base_query = {
        "fields": fields,
        "orderBy": "startTime",
        "singleEvents": "true",
        "timeMax": time_max,
        "timeMin": time_min,
    }
    events: list[dict[str, Any]] = []
    page_token: Optional[str] = None
    seen_page_tokens: set[str] = set()
    page_count = 0
    while True:
        page_count += 1
        if page_count > MAX_EVENT_PAGES:
            raise ApiError("Google returned too many event pages")
        query = dict(base_query)
        if page_token:
            query["pageToken"] = page_token
        url = f"{CALENDAR_EVENTS_URL}?{urllib.parse.urlencode(query)}"
        page = request_json(
            url,
            headers={"Authorization": f"Bearer {access_token}"},
            urlopen=urlopen,
        )
        items = page.get("items", [])
        if not isinstance(items, list):
            raise ApiError("Google returned invalid calendar events")
        for item in items:
            if isinstance(item, dict):
                normalized = normalize_event(item)
                if normalized is not None:
                    events.append(normalized)
                    if len(events) > MAX_EVENTS:
                        raise ApiError("Google returned too many calendar events")
        next_token = page.get("nextPageToken")
        if next_token is None:
            break
        if not isinstance(next_token, str) or not next_token:
            raise ApiError("Google returned an invalid page token")
        if next_token in seen_page_tokens:
            raise ApiError("Google repeated an event page token")
        seen_page_tokens.add(next_token)
        page_token = next_token
    return events


def normalize_event(event: Mapping[str, Any]) -> Optional[dict[str, Any]]:
    if event.get("status") == "cancelled" or event.get("eventType") == "workingLocation":
        return None
    attendees = event.get("attendees", [])
    if isinstance(attendees, list):
        for attendee in attendees:
            if (
                isinstance(attendee, dict)
                and attendee.get("self") is True
                and attendee.get("responseStatus") == "declined"
            ):
                return None

    event_id = event.get("id")
    start_value = event.get("start")
    end_value = event.get("end")
    if not isinstance(event_id, str) or not event_id:
        return None
    if not isinstance(start_value, dict) or not isinstance(end_value, dict):
        return None

    all_day = isinstance(start_value.get("date"), str)
    start = start_value.get("date") if all_day else start_value.get("dateTime")
    end = end_value.get("date") if all_day else end_value.get("dateTime")
    if not isinstance(start, str) or not start or not isinstance(end, str) or not end:
        return None

    summary = event.get("summary")
    if isinstance(summary, str):
        summary = "".join(
            character for character in summary
            if unicodedata.category(character)[0] != "C"
        )
        summary = " ".join(summary.split())[:MAX_SUMMARY_LENGTH]
    if not isinstance(summary, str) or not summary:
        summary = "Busy"
    event_type = event.get("eventType")
    transparency = event.get("transparency")
    return {
        "id": event_id,
        "summary": summary,
        "allDay": all_day,
        "start": start,
        "end": end,
        "eventType": event_type if isinstance(event_type, str) and event_type else "default",
        "transparency": transparency
        if isinstance(transparency, str) and transparency
        else "opaque",
    }


def get_status(
    *,
    path: Optional[Path] = None,
    secret_store: Optional[SecretStore] = None,
) -> dict[str, Any]:
    store = secret_store or SecretStore()
    configured = True
    reason: Optional[str] = None
    try:
        parse_client_config(path)
    except ClientConfigError:
        configured = False
        reason = "invalid_client_config"

    connected = False
    keyring_available = store.available
    if not keyring_available:
        reason = reason or "missing_secret_tool"
    else:
        try:
            connected = bool(store.lookup())
        except KeyringError:
            keyring_available = False
            reason = reason or "keyring_unavailable"

    result: dict[str, Any] = {
        "ok": True,
        "configured": configured,
        "connected": connected,
        "secretToolAvailable": keyring_available,
    }
    if reason:
        result["reason"] = reason
    return result


def list_events(
    client: OAuthClient,
    secret_store: SecretStore,
    time_min: str,
    time_max: str,
    request_id: str,
    *,
    urlopen: UrlOpen = urllib.request.urlopen,
) -> dict[str, Any]:
    access_token = refresh_access_token(client, secret_store, urlopen=urlopen)
    events = fetch_events(access_token, time_min, time_max, urlopen=urlopen)
    return {"ok": True, "requestId": request_id, "events": events}


def disconnect(
    secret_store: SecretStore,
    *,
    urlopen: UrlOpen = urllib.request.urlopen,
) -> dict[str, Any]:
    refresh_token = secret_store.lookup()
    revoked = False
    revoke_error: Optional[HelperError] = None
    if refresh_token:
        try:
            request_json(
                REVOKE_URL,
                form={"token": refresh_token},
                urlopen=urlopen,
                context="revoke",
            )
            revoked = True
        except HelperError as error:
            revoke_error = error
    secret_store.delete()
    result: dict[str, Any] = {
        "ok": True,
        "connected": False,
        "revoked": revoked,
        "localSecretRemoved": True,
    }
    if revoke_error:
        result["warning"] = "Google token could not be revoked; local credentials were removed"
    return result


def parse_rfc3339(value: str) -> datetime:
    candidate = value[:-1] + "+00:00" if value.endswith("Z") else value
    try:
        parsed = datetime.fromisoformat(candidate)
    except ValueError as error:
        raise UsageError("event range must use RFC3339 date-times") from error
    if parsed.tzinfo is None:
        raise UsageError("event range must include an RFC3339 timezone")
    return parsed


def validate_event_range(time_min: str, time_max: str) -> None:
    start = parse_rfc3339(time_min)
    end = parse_rfc3339(time_max)
    if end <= start:
        raise UsageError("time-max must be later than time-min")
    if end - start > MAX_QUERY_SPAN:
        raise UsageError("event range must not exceed 60 days")


def validate_rfc3339(value: str) -> str:
    if "T" not in value:
        raise argparse.ArgumentTypeError("must be an RFC3339 date-time")
    candidate = value[:-1] + "+00:00" if value.endswith("Z") else value
    try:
        parsed = datetime.fromisoformat(candidate)
    except ValueError as error:
        raise argparse.ArgumentTypeError("must be an RFC3339 date-time") from error
    if parsed.tzinfo is None:
        raise argparse.ArgumentTypeError("must include an RFC3339 timezone")
    return value


def build_parser() -> JsonArgumentParser:
    parser = JsonArgumentParser(prog="google-calendar-helper", add_help=False)
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("status", add_help=False)
    commands.add_parser("auth", add_help=False)
    events = commands.add_parser("events", add_help=False)
    events.add_argument("--time-min", required=True, type=validate_rfc3339)
    events.add_argument("--time-max", required=True, type=validate_rfc3339)
    events.add_argument("--request-id", required=True)
    commands.add_parser("disconnect", add_help=False)
    return parser


def parse_args(argv: Sequence[str]) -> argparse.Namespace:
    return build_parser().parse_args(argv)


def run_command(args: argparse.Namespace) -> dict[str, Any]:
    if args.command == "status":
        return get_status()

    secret_store = SecretStore()
    if args.command == "disconnect":
        return disconnect(secret_store)

    client = parse_client_config()
    if args.command == "auth":
        return authorize(client, secret_store)
    if args.command == "events":
        validate_event_range(args.time_min, args.time_max)
        return list_events(
            client,
            secret_store,
            args.time_min,
            args.time_max,
            args.request_id,
        )
    raise UsageError("unknown command")


def _error_result(error: HelperError) -> dict[str, Any]:
    return {"ok": False, "error": {"code": error.code, "message": error.message}}


def main(argv: Optional[Sequence[str]] = None) -> int:
    args: Optional[argparse.Namespace] = None
    try:
        args = parse_args(list(argv) if argv is not None else sys.argv[1:])
        result = run_command(args)
        exit_code = 0
    except HelperError as error:
        result = _error_result(error)
        if args is not None and args.command == "events":
            result["requestId"] = args.request_id
        exit_code = error.exit_code
    except Exception:
        result = _error_result(HelperError("unexpected helper failure"))
        result["error"]["code"] = "internal_error"
        exit_code = 1
    print(json.dumps(result, separators=(",", ":"), sort_keys=True))
    return exit_code


if __name__ == "__main__":
    raise SystemExit(main())
